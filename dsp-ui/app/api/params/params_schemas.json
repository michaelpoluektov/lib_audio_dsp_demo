  "ReverbPlateStereo": {
    "additionalProperties": false,
    "properties": {
      "predelay": {
        "default": 15,
        "description": "Set the predelay in milliseconds.",
        "maximum": 30.0,
        "minimum": 0.0,
        "title": "Predelay",
        "type": "number"
      },
      "width": {
        "default": 1.0,
        "description": "Range: 0 to 1",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Width",
        "type": "number"
      },
      "pregain": {
        "default": 0.5,
        "description": "It is not advised to increase this value above the default 0.015, as it can result in saturation inside the reverb delay lines.",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Pregain",
        "type": "number"
      },
      "wet_dry_mix": {
        "default": 0.5,
        "description": "It is not advised to increase this value above the default 0.015, as it can result in saturation inside the reverb delay lines.",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Wet Dry Mix",
        "type": "number"
      },
      "damping": {
        "default": 0.5,
        "description": "This controls how much high frequency attenuation is in the room. Higher values yield shorter reverberation times at high frequencies. Range: 0 to 1",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Damping",
        "type": "number"
      },
      "decay": {
        "default": 0.5,
        "description": "This sets how reverberant the room is. Higher values will give a longer reverberation time for a given room size. Range: 0 to 1",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Decay",
        "type": "number"
      },
      "early_diffusion": {
        "default": 0.2,
        "description": "Range: 0 to 1",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Early Diffusion",
        "type": "number"
      },
      "late_diffusion": {
        "default": 0.6,
        "description": "Range: 0 to 1",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Late Diffusion",
        "type": "number"
      },
      "bandwidth": {
        "default": 8000,
        "description": "Range: 0 to 1",
        "maximum": 24000.0,
        "minimum": 0.0,
        "title": "Bandwidth",
        "type": "number"
      }
    },
    "title": "ReverbPlateParams",
    "type": "object"
  },
